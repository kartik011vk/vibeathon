# Base URL of the DisplaceOS REST API. Keep "/api/v1" in development so requests go through the Vite proxy.
VITE_API_BASE_URL=/api/v1
# Socket.IO origin. Leave empty to use the current origin (proxied in development).
VITE_SOCKET_URL=
# Where the Vite dev server proxies /api and /socket.io.
VITE_DEV_PROXY_TARGET=http://localhost:4000
# Never put secrets in this file: every VITE_ variable is visible in the browser.
