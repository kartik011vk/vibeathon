# Copy to .env and replace every placeholder. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection. `npm run db:local` prints a working development URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/displaceos?schema=public
# Used only by `npm test` (the test runner resets this database).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/displaceos_test?schema=public

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Swagger UI at /api/docs. Set false to hide it in production.
SWAGGER_ENABLED=true

LOG_LEVEL=info

# Business rules (sensible defaults are applied when omitted).
INVENTORY_STALE_HOURS=48
LOCATION_STALE_MINUTES=30
ETA_DELAY_THRESHOLD_MINUTES=15
PUBLIC_TRACKING_TOKEN_TTL_HOURS=168
ESCALATION_JOB_ENABLED=false
ESCALATION_JOB_INTERVAL_SECONDS=300

# Optional providers. Leave blank to keep them disabled; the core app does not need them.
EMAIL_PROVIDER=
SMS_PROVIDER=
ROUTING_PROVIDER=
