{
  "name": "displaceos-backend",
  "version": "1.0.0",
  "description": "DisplaceOS disaster-relief coordination backend (Node.js, Express, PostgreSQL, Prisma, Socket.IO)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:local": "node scripts/local-postgres.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "demo:workflow": "node scripts/demo-workflow.js",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "test": "node scripts/run-tests.js",
    "lint": "node scripts/check-syntax.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "embedded-postgres": "17.6.0-beta.15",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@17.6.0-beta.15": true,
    "esbuild": true,
    "@scarf/scarf": false
  }
}
